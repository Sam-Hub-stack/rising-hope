# Required: local PostgreSQL connection
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional: email verification delivery via Resend
# Without this, verification links are stored in the email_outbox table and
# returned to the browser in demo mode.
RESEND_API_KEY=
EMAIL_FROM="Rising Hope <verify@risinghope.org>"

# Optional: public origin used in verification links (useful behind a proxy)
NEXT_PUBLIC_APP_URL=http://localhost:3000
